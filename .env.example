# Backend only. Never expose these values in browser code or commit a real .env file.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY
BOLD_API_KEY=YOUR_BOLD_API_KEY
BOLD_SECRET_KEY=YOUR_BOLD_WEBHOOK_SECRET
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM=Stand-Up Therapy <entradas@your-domain.example>
RESEND_REPLY_TO=jvbienestarysaludmental@javipenaloza.com
PAYMENT_ALERT_TO=jvbienestarysaludmental@javipenaloza.com
ADMIN_PASSWORD=USE_A_LONG_UNIQUE_PASSWORD
ADMIN_SESSION_SECRET=USE_A_SEPARATE_RANDOM_SECRET_WITH_AT_LEAST_32_BYTES
EVENT_PUBLIC_URL=https://YOUR_EVENT_DOMAIN.example
EVENT_RELEASE_ID=standup-therapy-deja-de-joder-pareja-bogota-5nov2026

# Keep both guards false until the database migration and controlled tests pass.
ENABLE_EVENT_OPERATIONS=false
ENABLE_REAL_PAYMENTS=false
